<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.deihs.mms.controller.UsersController"
      styleClass="page" spacing="16" maxWidth="Infinity" maxHeight="Infinity">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2">
            <Label text="User Accounts" styleClass="page-h1"/>
            <Label text="Manage accounts and review self-registration requests. Approve a request to create an active account."
                   styleClass="page-sub" wrapText="true"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="addButton" text="+  Add User" styleClass="btn-primary" onAction="#onAddUser"/>
    </HBox>

    <VBox fx:id="requestsCard" styleClass="card" spacing="0">
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 10 0;">
            <Label text="Pending Account Requests" styleClass="card-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="pendingCountLabel" styleClass="result-count" text=""/>
            <Button text="Refresh" styleClass="btn-ghost" onAction="#onRefresh"/>
        </HBox>
        <TableView fx:id="requestsTable" prefHeight="220">
            <columns>
                <TableColumn fx:id="reqEmpCol" text="EMP NO" prefWidth="100"/>
                <TableColumn fx:id="reqUsernameCol" text="USERNAME" prefWidth="120"/>
                <TableColumn fx:id="reqNameCol" text="NAME" prefWidth="180"/>
                <TableColumn fx:id="reqDeptCol" text="DEPARTMENT" prefWidth="140"/>
                <TableColumn fx:id="reqRoleCol" text="REQUESTED ROLE" prefWidth="150"/>
                <TableColumn fx:id="reqDateCol" text="SUBMITTED" prefWidth="140"/>
                <TableColumn fx:id="reqActionsCol" text="ACTIONS" prefWidth="170"/>
            </columns>
        </TableView>
    </VBox>

    <VBox styleClass="card" spacing="0" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 12 0;">
            <Label text="All Users" styleClass="card-title"/>
            <TextField fx:id="searchField" styleClass="input,search-input"
                       promptText="Search by name, username, employee no, or department"
                       HBox.hgrow="ALWAYS"/>
            <CheckBox fx:id="showInactiveBox" text="Show inactive"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userCountLabel" styleClass="result-count" text=""/>
        </HBox>
        <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="empCol" text="EMP NO" prefWidth="95"/>
                <TableColumn fx:id="usernameCol" text="USERNAME" prefWidth="120"/>
                <TableColumn fx:id="nameCol" text="NAME" prefWidth="180"/>
                <TableColumn fx:id="roleCol" text="ROLE" prefWidth="150"/>
                <TableColumn fx:id="deptCol" text="DEPARTMENT" prefWidth="140"/>
                <TableColumn fx:id="statusCol" text="STATUS" prefWidth="90"/>
                <TableColumn fx:id="lastLoginCol" text="LAST LOGIN" prefWidth="140"/>
                <TableColumn fx:id="userActionsCol" text="ACTIONS" prefWidth="250"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
