<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.deihs.mms.controller.RequestsController"
      styleClass="page" spacing="16" maxWidth="Infinity" maxHeight="Infinity">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2">
            <Label fx:id="heading" text="Maintenance Requests" styleClass="page-h1"/>
            <Label fx:id="subheading" styleClass="page-sub"
                   text="Every request filed across the school, newest first."/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="newButton" text="+  New Request" styleClass="btn-primary"
                onAction="#onNewRequest"/>
    </HBox>

    <VBox styleClass="card" spacing="12" VBox.vgrow="ALWAYS" maxWidth="Infinity"
          maxHeight="Infinity">

        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="searchField" styleClass="input, search-input"
                       promptText="Search ticket, issue, requester, facility…"
                       maxWidth="430" HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="statusFilter" styleClass="combo-input" prefWidth="158"/>
            <ComboBox fx:id="priorityFilter" styleClass="combo-input" prefWidth="146"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="countLabel" styleClass="result-count" text=""/>
        </HBox>

        <TableView fx:id="table" VBox.vgrow="ALWAYS" maxWidth="Infinity" maxHeight="Infinity">
            <columns>
                <TableColumn fx:id="colTicket" text="TICKET" prefWidth="82" minWidth="70"/>
                <TableColumn fx:id="colRequester" text="REQUESTER" prefWidth="126" minWidth="96"/>
                <TableColumn fx:id="colAsset" text="FACILITY / EQUIPMENT" prefWidth="160" minWidth="110"/>
                <TableColumn fx:id="colIssue" text="ISSUE" prefWidth="240" minWidth="150"/>
                <TableColumn fx:id="colPriority" text="PRIORITY" prefWidth="84" minWidth="74"/>
                <TableColumn fx:id="colStatus" text="STATUS" prefWidth="104" minWidth="92"/>
                <TableColumn fx:id="colAssignee" text="ASSIGNED TO" prefWidth="132" minWidth="100"/>
                <TableColumn fx:id="colDue" text="DUE" prefWidth="96" minWidth="80"/>
                <TableColumn fx:id="colDate" text="REPORTED" prefWidth="98" minWidth="82"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
