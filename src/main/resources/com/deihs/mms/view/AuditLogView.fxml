<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.deihs.mms.controller.AuditLogController"
      styleClass="page" spacing="16" maxWidth="Infinity" maxHeight="Infinity">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2">
            <Label text="Audit Log" styleClass="page-h1"/>
            <Label text="Read-only record of sign-ins and important system changes." styleClass="page-sub"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <VBox styleClass="card" spacing="0" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 12 0;">
            <TextField fx:id="searchField" styleClass="input,search-input"
                       promptText="Search by user, action, entity, or details"
                       HBox.hgrow="ALWAYS"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="countLabel" styleClass="result-count" text=""/>
        </HBox>

        <TableView fx:id="table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="timeCol" text="TIME" prefWidth="160"/>
                <TableColumn fx:id="actorCol" text="USER" prefWidth="160"/>
                <TableColumn fx:id="actionCol" text="ACTION" prefWidth="170"/>
                <TableColumn fx:id="entityCol" text="ENTITY" prefWidth="150"/>
                <TableColumn fx:id="entityIdCol" text="ID" prefWidth="90"/>
                <TableColumn fx:id="detailsCol" text="DETAILS" prefWidth="320"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
