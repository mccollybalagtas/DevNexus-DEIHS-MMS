<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.deihs.mms.controller.FacilitiesController"
      styleClass="page" spacing="16" maxWidth="Infinity" maxHeight="Infinity">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2">
            <Label text="Facilities" styleClass="page-h1"/>
            <Label text="Campus rooms and areas. Archive a facility instead of deleting it so its history stays intact."
                   styleClass="page-sub" wrapText="true"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="addButton" text="+  Add Facility" styleClass="btn-primary"
                onAction="#onAdd"/>
    </HBox>

    <VBox styleClass="card" spacing="0" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 12 0;">
            <TextField fx:id="searchField" styleClass="input,search-input"
                       promptText="Search by code, name, building, room, or type"
                       HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="conditionBox" styleClass="combo-input" prefWidth="175"/>
            <CheckBox fx:id="showArchivedBox" text="Show archived"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="countLabel" styleClass="result-count" text=""/>
        </HBox>

        <TableView fx:id="table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="codeCol" text="CODE" prefWidth="90"/>
                <TableColumn fx:id="nameCol" text="FACILITY" prefWidth="210"/>
                <TableColumn fx:id="buildingCol" text="BUILDING" prefWidth="140"/>
                <TableColumn fx:id="floorCol" text="FLOOR" prefWidth="70"/>
                <TableColumn fx:id="roomCol" text="ROOM" prefWidth="80"/>
                <TableColumn fx:id="typeCol" text="TYPE" prefWidth="120"/>
                <TableColumn fx:id="conditionCol" text="CONDITION" prefWidth="125"/>
                <TableColumn fx:id="equipmentCol" text="EQUIPMENT" prefWidth="90"/>
                <TableColumn fx:id="openCol" text="OPEN" prefWidth="70"/>
                <TableColumn fx:id="actionsCol" text="ACTIONS" prefWidth="170"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
