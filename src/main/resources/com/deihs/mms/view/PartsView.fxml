<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.deihs.mms.controller.PartsController"
      styleClass="page" spacing="16" maxWidth="Infinity" maxHeight="Infinity">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2">
            <Label text="Parts &amp; Inventory" styleClass="page-h1"/>
            <Label text="Track spare parts and consumables. Low-stock items are highlighted so you can reorder before work stalls."
                   styleClass="page-sub" wrapText="true"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="addButton" text="+  Add Part" styleClass="btn-primary"
                onAction="#onAdd"/>
    </HBox>

    <VBox styleClass="card" spacing="0" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 12 0;">
            <TextField fx:id="searchField" styleClass="input,search-input"
                       promptText="Search by name, SKU, or unit"
                       HBox.hgrow="ALWAYS"/>
            <CheckBox fx:id="lowOnlyBox" text="Low stock only"/>
            <CheckBox fx:id="showArchivedBox" text="Show archived"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="countLabel" styleClass="result-count" text=""/>
        </HBox>

        <TableView fx:id="table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="nameCol" text="PART" prefWidth="240"/>
                <TableColumn fx:id="skuCol" text="SKU" prefWidth="130"/>
                <TableColumn fx:id="unitCol" text="UNIT" prefWidth="80"/>
                <TableColumn fx:id="stockCol" text="STOCK" prefWidth="90"/>
                <TableColumn fx:id="reorderCol" text="REORDER AT" prefWidth="105"/>
                <TableColumn fx:id="costCol" text="UNIT COST" prefWidth="120"/>
                <TableColumn fx:id="valueCol" text="VALUE" prefWidth="120"/>
                <TableColumn fx:id="statusCol" text="STATUS" prefWidth="115"/>
                <TableColumn fx:id="actionsCol" text="ACTIONS" prefWidth="170"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
