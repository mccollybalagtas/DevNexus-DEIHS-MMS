<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.deihs.mms.controller.SchedulesController"
      styleClass="page" spacing="16" maxWidth="Infinity" maxHeight="Infinity">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2">
            <Label text="Preventive Maintenance Schedules" styleClass="page-h1"/>
            <Label text="Recurring maintenance plans for facilities and equipment. Generate work orders from due schedules and review them on the calendar."
                   styleClass="page-sub" wrapText="true"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="generateButton" text="Generate Work Orders" styleClass="btn-ghost"
                onAction="#onGenerateWorkOrders"/>
        <Button fx:id="addButton" text="+  Add Schedule" styleClass="btn-primary"
                onAction="#onAdd"/>
    </HBox>

    <TabPane fx:id="tabPane" styleClass="content-tabs" VBox.vgrow="ALWAYS">
        <tabs>
            <Tab text="Schedule List" closable="false">
                <content>
                    <VBox styleClass="card" spacing="0" maxWidth="Infinity" maxHeight="Infinity">
                        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 12 0;">
                            <TextField fx:id="searchField" styleClass="input,search-input"
                                       promptText="Search by title, facility, equipment, or assignee"
                                       HBox.hgrow="ALWAYS"/>
                            <CheckBox fx:id="dueOnlyBox" text="Due / overdue only"/>
                            <CheckBox fx:id="showInactiveBox" text="Show inactive"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="countLabel" styleClass="result-count" text=""/>
                        </HBox>

                        <TableView fx:id="table" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="titleCol" text="SCHEDULE" prefWidth="220"/>
                                <TableColumn fx:id="targetCol" text="FACILITY / EQUIPMENT" prefWidth="220"/>
                                <TableColumn fx:id="freqCol" text="FREQUENCY" prefWidth="110"/>
                                <TableColumn fx:id="nextDueCol" text="NEXT DUE" prefWidth="120"/>
                                <TableColumn fx:id="lastDoneCol" text="LAST DONE" prefWidth="120"/>
                                <TableColumn fx:id="assignedCol" text="ASSIGNED TO" prefWidth="150"/>
                                <TableColumn fx:id="statusCol" text="STATUS" prefWidth="100"/>
                                <TableColumn fx:id="actionsCol" text="ACTIONS" prefWidth="240"/>
                            </columns>
                        </TableView>
                    </VBox>
                </content>
            </Tab>
            <Tab text="Calendar" closable="false">
                <content>
                    <VBox styleClass="card" spacing="12" maxWidth="Infinity" maxHeight="Infinity">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Button fx:id="prevMonthButton" text="‹" styleClass="btn-ghost" onAction="#onPrevMonth"/>
                            <Label fx:id="monthLabel" styleClass="card-title"/>
                            <Button fx:id="nextMonthButton" text="›" styleClass="btn-ghost" onAction="#onNextMonth"/>
                            <Button fx:id="todayButton" text="Today" styleClass="btn-ghost" onAction="#onTodayMonth"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="calendarHintLabel" styleClass="page-sub" text="Due schedules are shown on their next due date."/>
                        </HBox>
                        <GridPane fx:id="calendarGrid" hgap="8" vgap="8" VBox.vgrow="ALWAYS"/>
                        <Label fx:id="calendarLegendLabel" styleClass="page-sub" wrapText="true"/>
                    </VBox>
                </content>
            </Tab>
        </tabs>
    </TabPane>
</VBox>
