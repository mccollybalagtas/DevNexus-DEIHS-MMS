<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.deihs.mms.controller.LoginController"
      styleClass="login-root" prefWidth="1180" prefHeight="720"
      maxWidth="Infinity" maxHeight="Infinity">

    <!-- ================= Brand panel ================= -->
    <StackPane fx:id="brandPane" styleClass="login-brand"
               HBox.hgrow="ALWAYS" minWidth="420">

        <!-- Optional building photo. The controller turns this on only when
             /com/deihs/mms/img/login-building.jpg exists. -->
        <Region fx:id="buildingLayer" styleClass="login-building-layer"
                maxWidth="Infinity" maxHeight="Infinity"/>

        <Region styleClass="login-brand-overlay"
                maxWidth="Infinity" maxHeight="Infinity"/>

        <!-- Soft light accents behind the crest. -->
        <Circle radius="330" fill="#3B82F6" opacity="0.10"
                translateX="-280" translateY="-250"/>
        <Circle radius="260" fill="#60A5FA" opacity="0.07"
                translateX="330" translateY="280"/>
        <Region styleClass="login-brand-beam" prefWidth="1250" prefHeight="120"
                rotate="-16" translateY="170"/>

        <VBox alignment="CENTER" spacing="0" maxWidth="540"
              StackPane.alignment="CENTER">
            <StackPane styleClass="login-logo-wrap">
                <Circle radius="104" fill="#FFFFFF" opacity="0.07"/>
                <Circle radius="92" fill="#FFFFFF" opacity="0.05"/>
                <ImageView fitWidth="172" fitHeight="172" preserveRatio="true"
                           smooth="true" styleClass="login-logo-image">
                    <image>
                        <Image url="@../img/deihs-logo.png"/>
                    </image>
                </ImageView>
            </StackPane>

            <Label fx:id="schoolLine1" text="DASMARIÑAS EAST" styleClass="login-school-line1"
                   alignment="CENTER" textAlignment="CENTER">
                <VBox.margin>
                    <Insets top="16"/>
                </VBox.margin>
            </Label>
            <Label fx:id="schoolLine2" text="INTEGRATED HIGH SCHOOL" styleClass="login-school-line2"
                   alignment="CENTER" textAlignment="CENTER"/>

            <HBox alignment="CENTER" spacing="12">
                <VBox.margin>
                    <Insets top="16" bottom="14"/>
                </VBox.margin>
                <Region styleClass="login-rule" prefWidth="72" prefHeight="1"/>
                <Region styleClass="login-rule-diamond" prefWidth="7" prefHeight="7"
                        rotate="45"/>
                <Region styleClass="login-rule" prefWidth="72" prefHeight="1"/>
            </HBox>

            <Label fx:id="locationLabel" text="San Simon, City of Dasmariñas" styleClass="login-location"
                   alignment="CENTER" textAlignment="CENTER"/>
        </VBox>

        <Label text="Maintenance Management System" styleClass="login-brand-footer"
               StackPane.alignment="BOTTOM_CENTER">
            <StackPane.margin>
                <Insets bottom="26"/>
            </StackPane.margin>
        </Label>
    </StackPane>

    <!-- ================= Sign-in panel ================= -->
    <StackPane fx:id="signInPane" styleClass="login-panel" prefWidth="560" minWidth="480"
               maxWidth="720" HBox.hgrow="NEVER">

        <!-- Decorative blue curves / blobs from the reference. -->
        <Circle radius="290" fill="#1A47B8" opacity="0.055"
                translateX="250" translateY="-240"/>
        <Circle radius="240" fill="#3B82F6" opacity="0.05"
                translateX="-260" translateY="280"/>
        <Region styleClass="login-blob" prefWidth="560" prefHeight="560"
                translateX="270" translateY="-250" maxWidth="560" maxHeight="560"/>

        <VBox styleClass="login-card" spacing="11" alignment="TOP_LEFT"
              maxHeight="-Infinity">

            <Label fx:id="headingLabel" text="Welcome Back" styleClass="login-heading"/>
            <Label text="Please enter your details to sign in" styleClass="login-sub">
                <VBox.margin>
                    <Insets top="-4" bottom="4"/>
                </VBox.margin>
            </Label>

            <Label fx:id="errorLabel" styleClass="form-error" wrapText="true"
                   visible="false" managed="false" maxWidth="Infinity"/>

            <TextField fx:id="usernameField" styleClass="login-input"
                       promptText="Username" maxWidth="Infinity"/>

            <StackPane>
                <PasswordField fx:id="passwordField"
                               styleClass="login-input, login-input-password"
                               promptText="Password" maxWidth="Infinity"/>
                <TextField fx:id="passwordVisible"
                           styleClass="login-input, login-input-password"
                           promptText="Password" visible="false" managed="false"
                           maxWidth="Infinity"/>

                <Button fx:id="togglePasswordButton" styleClass="password-toggle"
                        onAction="#onTogglePassword" focusTraversable="false"
                        accessibleText="Show password"
                        StackPane.alignment="CENTER_RIGHT">
                    <StackPane.margin>
                        <Insets right="8"/>
                    </StackPane.margin>
                    <graphic>
                        <StackPane>
                            <SVGPath fx:id="eyeOpenIcon"
                                     content="M1 12s4-7.5 11-7.5S23 12 23 12s-4 7.5-11 7.5S1 12 1 12z M12 9.2a2.8 2.8 0 1 0 0 5.6 2.8 2.8 0 0 0 0-5.6z"
                                     fill="transparent" stroke="#64748B"
                                     strokeWidth="1.8" strokeLineCap="ROUND"
                                     strokeLineJoin="ROUND" scaleX="0.85" scaleY="0.85"/>
                            <SVGPath fx:id="eyeClosedIcon"
                                     content="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24 M1 1l22 22"
                                     fill="transparent" stroke="#64748B"
                                     strokeWidth="1.8" strokeLineCap="ROUND"
                                     strokeLineJoin="ROUND" visible="false"
                                     scaleX="0.85" scaleY="0.85"/>
                        </StackPane>
                    </graphic>
                </Button>
            </StackPane>

            <HBox alignment="CENTER_LEFT" spacing="8">
                <CheckBox fx:id="rememberMe" text="Remember Me" styleClass="login-check"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Hyperlink text="Forgot Password?" styleClass="login-link"
                           onAction="#onForgotPassword"/>
            </HBox>

            <Button fx:id="signInButton" text="Sign In" styleClass="login-signin"
                    onAction="#onSignIn" maxWidth="Infinity">
                <VBox.margin>
                    <Insets top="4"/>
                </VBox.margin>
            </Button>

            <VBox fx:id="googleBox" spacing="10">
                <HBox alignment="CENTER" spacing="10">
                    <Region styleClass="login-divider" prefHeight="1"
                            HBox.hgrow="ALWAYS"/>
                    <Label text="or" styleClass="login-or"/>
                    <Region styleClass="login-divider" prefHeight="1"
                            HBox.hgrow="ALWAYS"/>
                </HBox>
                <Button fx:id="googleButton" text="Continue with Google"
                        styleClass="login-google" onAction="#onGoogleSignIn"
                        maxWidth="Infinity"/>
            </VBox>

            <Region styleClass="login-divider" prefHeight="1" maxWidth="Infinity">
                <VBox.margin>
                    <Insets top="4" bottom="2"/>
                </VBox.margin>
            </Region>

            <HBox alignment="CENTER" spacing="4">
                <Label text="Don't have an account?" styleClass="login-footer-note"/>
                <Hyperlink text="Create account" styleClass="login-link"
                           onAction="#onCreateAccount"/>
            </HBox>

            <Label text="New accounts are reviewed by the School Administrator before sign-in is enabled."
                   styleClass="login-footer-note" wrapText="true"
                   textAlignment="CENTER" alignment="CENTER" maxWidth="Infinity"/>
        </VBox>
    </StackPane>
</HBox>
