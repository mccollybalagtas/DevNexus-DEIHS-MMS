<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.deihs.mms.controller.EquipmentController"
      styleClass="page" spacing="16" maxWidth="Infinity" maxHeight="Infinity">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2">
            <Label text="Equipment" styleClass="page-h1"/>
            <Label text="Equipment inventory linked to campus facilities. Archive items to keep history."
                   styleClass="page-sub" wrapText="true"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="exportButton" text="Export CSV" styleClass="btn-ghost" onAction="#onExportCsv"/>
        <Button fx:id="importButton" text="Import CSV" styleClass="btn-ghost" onAction="#onImportCsv"/>
        <Button fx:id="addButton" text="+  Add Equipment" styleClass="btn-primary"
                onAction="#onAdd"/>
    </HBox>

    <VBox styleClass="card" spacing="0" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 12 0;">
            <TextField fx:id="searchField" styleClass="input,search-input"
                       promptText="Search by property no, name, category, brand, model, serial, or facility"
                       HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="conditionBox" styleClass="combo-input" prefWidth="170"/>
            <ComboBox fx:id="facilityBox" styleClass="combo-input" prefWidth="220"/>
            <CheckBox fx:id="showArchivedBox" text="Show archived"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="countLabel" styleClass="result-count" text=""/>
        </HBox>

        <TableView fx:id="table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="propertyCol" text="PROPERTY NO" prefWidth="120"/>
                <TableColumn fx:id="nameCol" text="EQUIPMENT" prefWidth="180"/>
                <TableColumn fx:id="categoryCol" text="CATEGORY" prefWidth="120"/>
                <TableColumn fx:id="brandCol" text="BRAND / MODEL" prefWidth="160"/>
                <TableColumn fx:id="facilityCol" text="FACILITY" prefWidth="170"/>
                <TableColumn fx:id="conditionCol" text="CONDITION" prefWidth="120"/>
                <TableColumn fx:id="acquiredCol" text="ACQUIRED" prefWidth="110"/>
                <TableColumn fx:id="actionsCol" text="ACTIONS" prefWidth="170"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
